<Project Sdk="Microsoft.NET.Sdk">
  <!-- Maps the console's x64 images on Windows and binds their Xbox-only imports to the shims in this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fivestar-loader</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CET shadow stacks fail-fast (0x30) when SEH resumes inside manually mapped code. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveStar.Loader.Tests" />
    <InternalsVisibleTo Include="FiveStar.Benchmarks" />
  </ItemGroup>
</Project>
