<Project Sdk="Microsoft.NET.Sdk">
  <!-- Costs of the loader's per-call paths: a call into a shim entry point, XMem allocations, task queue dispatch. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FiveStar.Loader\FiveStar.Loader.csproj" />
  </ItemGroup>
</Project>
